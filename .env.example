# Türk Telekom 6G Platform — Ortam Değişkenleri
# Bu dosyayı proje kökünde .env olarak kopyalayın.
# .env dosyası git'e eklenmez (.gitignore).

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# İsteğe bağlı: tek model (varsayılan: gemini-3.1-pro-preview)
# GEMINI_CHAT_MODEL=gemini-3.1-pro-preview

# Varsayılan AI sağlayıcı (groq | gemini)
DEFAULT_AI_PROVIDER=groq

# Yayın kaynakları — anahtar yoksa hücre —.
# IEEE: kayıt bireysel mail ile açılır; anahtar onayı kurum sitesi ister.
IEEE_API_KEY=
# Springer: bireysel mail yeter. Yayın grafikleri bu anahtarı kullanır.
SPRINGER_API_KEY=
# Elsevier: hesap bireysel olabilir; Scopus ülke sayımı için kurum token.
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
# Google Scholar resmi API yok; HTML çekilmez. SerpAPI üçüncü taraf (opsiyonel).
SERPAPI_KEY=

# Patent ofisleri — IEEE patent sunmaz. Kurumsal abonelik yok; bireysel anahtar.
# Lens.org: tarayıcıda api.lens.org açılmaz. Token: https://www.lens.org/lens/user/subscriptions
LENS_TOKEN=
# USPTO PatentsView — https://patentsview.org/apis/api-registration
PATENTSVIEW_API_KEY=
# EPO OPS (Espacenet) — https://developers.epo.org/  consumer key + secret
EPO_OPS_KEY=
EPO_OPS_SECRET=
